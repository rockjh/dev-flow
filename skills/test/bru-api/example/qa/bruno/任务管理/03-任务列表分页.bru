meta {
  name: list-tasks-page
  type: http
}

get {
  url: {{base_url}}/tasks?page=1&pageSize=20&sort=createdAt.desc
}

headers {
  Authorization: Bearer {{auth_token}}
  X-Tenant-Id: {{tenant_id}}
}

tests {
  test("返回第一页", function() {
    expect(res.status).to.equal(200);
    expect(res.body.page).to.equal(1);
  });
}
