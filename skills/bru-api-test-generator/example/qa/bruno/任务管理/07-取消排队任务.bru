meta {
  name: cancel-task-queued
  type: http
}

post {
  url: {{base_url}}/tasks/{{task_id}}/cancel
}

headers {
  Authorization: Bearer {{auth_token}}
  X-Tenant-Id: {{tenant_id}}
}

tests {
  test("受理取消请求", function() {
    expect(res.status).to.equal(202);
    expect(res.body.status).to.equal("cancelling");
  });
}
