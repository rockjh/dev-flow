meta {
  name: list-tasks-empty
  type: http
}

get {
  url: {{base_url}}/tasks?page=1&pageSize=20&status=completed
}

headers {
  Authorization: Bearer {{auth_token}}
  X-Tenant-Id: {{tenant_id}}
}

tests {
  test("返回空结果", function() {
    expect(res.status).to.equal(200);
    expect(res.body.total).to.equal(0);
  });
}
